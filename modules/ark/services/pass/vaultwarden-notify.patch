 //
 // String util methods
 //
+/// ark: write $<var> (a file path, when the variable is set) so that whatever
+/// a systemd path unit runs on it can react right then: KEYS_CHANGED_FILE once
+/// a user's key pair is stored, CIPHERS_CHANGED_FILE whenever an item is
+/// saved or deleted.
+pub fn notify_changed(var: &str) {
+    if let Ok(path) = env::var(var) {
+        if let Err(e) = std::fs::write(&path, get_uuid()) {
+            warn!("Could not write {var} {path}: {e}");
+        }
+    }
+}
