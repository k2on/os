+/// ark: once a user's key pair is stored, write $KEYS_CHANGED_FILE (when set),
+/// so what confirms people into organizations can run right then (a systemd
+/// path unit watches the file).
+pub fn notify_keys_changed() {
+    if let Ok(path) = env::var("KEYS_CHANGED_FILE") {
+        if let Err(e) = std::fs::write(&path, get_uuid()) {
+            warn!("Could not write KEYS_CHANGED_FILE {path}: {e}");
+        }
+    }
+}
