# Underscore: import-tree loads every other .nix under modules/ as a flake module.
#
# Builds one member of the Rust workspace in this directory (Cargo.toml):
#   pkgs.callPackage ./_rust.nix { pname = "ark"; }
# Dependencies come from Cargo.lock; `cargo update` here and rebuild. The
# .js files are what sivrad-browser embeds (include_str!).
#
# A member is built as a workspace of its own, so it rebuilds only when it
# changes: its source is its own directory, under a root Cargo.toml naming
# it alone (with just the workspace dependencies it uses), and a Cargo.lock
# with just the packages it needs, cut from the workspace's. Adding or
# changing another member, or a dependency only another uses, leaves it
# alone. `ark` adds the services' cli/ code it compiles in (cli/build.rs).
{
  lib,
  rustPlatform,
  writeText,
  runCommand,
  formats,
  pname,
}:
let
  inherit (lib) fileset;
  workspace = (lib.importTOML ./Cargo.toml).workspace;
  members = workspace.members;
  manifestOf = dir: lib.importTOML (./. + "/${dir}/Cargo.toml");
  dir = lib.findFirst (
    d: (manifestOf d).package.name == pname
  ) (throw "_rust.nix: no workspace member is named ${pname}") members;
  manifest = manifestOf dir;
  code = fileset.fileFilter (f: f.hasExt "rs" || f.hasExt "js");

  serviceClis = lib.filter builtins.pathExists (
    lib.mapAttrsToList (name: _: ./services + "/${name}/cli") (
      lib.filterAttrs (_: type: type == "directory") (builtins.readDir ./services)
    )
  );

  # The workspace dependencies it names (`x.workspace = true`).
  used = lib.unique (
    lib.concatMap
      (
        section:
        lib.attrNames (
          lib.filterAttrs (_: d: lib.isAttrs d && d.workspace or false) (manifest.${section} or { })
        )
      )
      [
        "dependencies"
        "build-dependencies"
        "dev-dependencies"
      ]
  );
  rootToml = (lib.importTOML ./Cargo.toml) // {
    workspace = workspace // {
      members = [ dir ];
      dependencies = lib.getAttrs used (workspace.dependencies or { });
    };
  };

  # Its packages from Cargo.lock: the closure of its own entry. A
  # dependency is "name", or "name version" where several versions are
  # locked (or "name version (source)").
  lock = lib.importTOML ./Cargo.lock;
  versionsOf = lib.groupBy (p: p.name) lock.package;
  resolve =
    spec:
    let
      parts = lib.splitString " " spec;
      name = lib.head parts;
      candidates = versionsOf.${name} or [ ];
    in
    if lib.length parts > 1 then
      lib.filter (p: p.version == lib.elemAt parts 1) candidates
    else
      candidates;
  keyOf = p: "${p.name} ${p.version} ${p.source or ""}";
  closure = lib.genericClosure {
    startSet = map (p: {
      key = keyOf p;
      pkg = p;
    }) (resolve pname);
    operator =
      item:
      lib.concatMap (
        spec:
        map (p: {
          key = keyOf p;
          pkg = p;
        }) (resolve spec)
      ) (item.pkg.dependencies or [ ]);
  };
  kept = lib.genAttrs (map (i: i.key) closure) (_: true);
  # In the workspace's order, as cargo writes it.
  packages = lib.filter (p: kept ? ${keyOf p}) lock.package;
  keptVersions = lib.groupBy (p: p.name) packages;
  # What cargo would write for a dependency now: its version only if more
  # than one of that name is still locked.
  spec =
    s:
    let
      name = lib.head (lib.splitString " " s);
    in
    if lib.length (keptVersions.${name} or [ ]) > 1 then s else name;
  q = s: ''"${s}"'';
  entry =
    p:
    lib.concatStringsSep "\n" (
      [
        ""
        "[[package]]"
        "name = ${q p.name}"
        "version = ${q p.version}"
      ]
      ++ lib.optional (p ? source) "source = ${q p.source}"
      ++ lib.optional (p ? checksum) "checksum = ${q p.checksum}"
      ++ lib.optionals (p.dependencies or [ ] != [ ]) (
        [ "dependencies = [" ] ++ map (d: " ${q (spec d)},") p.dependencies ++ [ "]" ]
      )
    );
  lockFile = writeText "Cargo.lock" (
    ''
      # This file is automatically @generated by Cargo.
      # It is not intended for manual editing.
      version = ${toString lock.version}
    ''
    + lib.concatMapStrings (p: entry p + "\n") packages
  );

  memberSrc = fileset.toSource {
    root = ./.;
    fileset = fileset.unions (
      [
        (./. + "/${dir}/Cargo.toml")
        (code (./. + "/${dir}"))
      ]
      ++ lib.optional (builtins.pathExists (./. + "/${dir}/build.rs")) (./. + "/${dir}/build.rs")
      ++ lib.optionals (dir == "cli") (map code serviceClis)
    );
  };
  src = runCommand "${pname}-src" { } ''
    cp -r ${memberSrc} $out
    chmod -R u+w $out
    cp ${(formats.toml { }).generate "Cargo.toml" rootToml} $out/Cargo.toml
    cp ${lockFile} $out/Cargo.lock
  '';
in
rustPlatform.buildRustPackage {
  inherit pname src;
  version = workspace.package.version;
  cargoLock.lockFile = lockFile;

  cargoBuildFlags = [
    "-p"
    pname
  ];
  cargoTestFlags = [
    "-p"
    pname
  ];

  meta.mainProgram = pname;
}
