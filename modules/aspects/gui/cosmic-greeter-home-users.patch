+    /// Everyone to list: the accounts the system enumerates that pass
+    /// `filter`, then whoever has a home under /home, looked up by name.
+    /// Directory services (Kanidm, SSSD) answer for one account but do not
+    /// enumerate theirs, and give out UIDs above UID_MAX, so this is how
+    /// someone who has signed in here before is listed. Those must still be
+    /// above UID_MIN, and have a login shell.
+    pub fn users(&self) -> Vec<pwd::Passwd> {
+        // The pwd::Passwd method is unsafe (but not labelled as such) due to using global state (libc pwent functions).
+        // To prevent issues, this should only be called once in the entire process space at a time
+        let mut users: Vec<pwd::Passwd> = pwd::Passwd::iter().filter(|user| self.filter(user)).collect();
+
+        let mut names: Vec<String> = fs::read_dir("/home")
+            .map(|dir| {
+                dir.flatten()
+                    .filter_map(|entry| entry.file_name().into_string().ok())
+                    .collect()
+            })
+            .unwrap_or_default();
+        names.sort();
+        for name in names {
+            let Ok(Some(user)) = pwd::Passwd::from_name(&name) else {
+                continue;
+            };
+            // The name itself, not another way to it (a home named by UUID).
+            if user.name != name
+                || user.uid < self.uid_min
+                || !Self::login_shell(&user)
+                || users.iter().any(|known| known.uid == user.uid)
+            {
+                continue;
+            }
+            users.push(user);
+        }
+        users
+    }
